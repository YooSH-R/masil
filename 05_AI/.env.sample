# GMS API 키 (필수)
GMS_KEY=YOUR_GMS_KEY_HERE

# AWS 접근 키
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY


# 아래는 모두 선택. 비워 두면 walklog/config.py 의 기본값을 쓴다.
# GMS_BASE=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta
# GMS_TEXT_MODEL=gemini-3.5-flash
# GMS_IMAGE_MODEL=gemini-2.5-flash-image
# GMS_TIMEOUT=60

# 프록시가 systemInstruction 을 무시할 때만 merge 로 바꾼다.
# GMS_SYSTEM_MODE=system_instruction

# 프록시가 responseSchema 를 거부할 때만 0 으로 내린다.
# GMS_USE_RESPONSE_SCHEMA=1

# S3 업로드는 기본으로 켜져 있다(끄려면 실행 시 --no-upload-s3).
# 버킷/기기 ID/프리픽스는 이미 기본값이 있으니 다른 값을 쓸 때만 아래를 채운다.
# AWS 자격증명(AWS_ACCESS_KEY_ID 등)은 boto3의 표준 방식
# (환경변수 / ~/.aws/credentials / IAM 역할)을 그대로 쓴다.
# S3_BUCKET=walk-picture-s3-483461801092-ap-northeast-2-an
# DEVICE_ID=device-001
# S3_PREFIX=robot-images/device-001
# AWS_REGION=ap-northeast-2