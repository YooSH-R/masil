DB_URL=jdbc:postgresql://localhost:5432/mysil
DB_USERNAME=mysil
DB_PASSWORD=change-this-local-password

GOOGLE_CLIENT_ID=change-this-google-client-id
KAKAO_NATIVE_APP_KEY=change-this-kakao-native-app-key
JWT_SECRET=change-this-to-a-long-random-local-secret
ROBOT_PAIRING_RATE_LIMIT_MAX_ATTEMPTS=10
ROBOT_PAIRING_RATE_LIMIT_WINDOW=1m
WALK_LOCATION_LATE_GRACE_SECONDS=120
WALK_PROPOSAL_EXPIRATION_SCHEDULER_ENABLED=true
WALK_PROPOSAL_EXPIRATION_DELAY_MS=60000
WALK_PROPOSAL_PRODUCER_DUE_AFTER=72h
WALK_PROPOSAL_PRODUCER_TTL=30m
WALK_PROPOSAL_REQUEST_RETRY_COOLDOWN=3h
WALK_PROPOSAL_PRODUCER_SLEEPING_MODES=SLEEP,SLEEPING,ASLEEP
WALK_LOCATION_BATCH_REQUEST_RETENTION_SECONDS=2592000
WALK_LOCATION_BATCH_REQUEST_CLEANUP_SCHEDULER_ENABLED=true
WALK_LOCATION_BATCH_REQUEST_CLEANUP_DELAY_MS=3600000
WALK_LOCATION_BATCH_REQUEST_CLEANUP_BATCH_SIZE=1000
SOLAPI_API_KEY=change-this-solapi-api-key
SOLAPI_SECRET_KEY=change-this-solapi-secret-key
SOLAPI_SENDER=change-this-registered-sender-number
JPA_DDL_AUTO=validate
