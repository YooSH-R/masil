def gitlabWebhookToken = System.getenv('GITLAB_WEBHOOK_TOKEN')

if (!gitlabWebhookToken?.trim()) {
    throw new IllegalStateException(
        'GITLAB_WEBHOOK_TOKEN is not configured on the Jenkins controller.'
    )
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    triggers {
        gitlab(
            triggerOnPush: true,
            triggerOnMergeRequest: false,
            branchFilterType: 'NameBasedFilter',
            includeBranchesSpec: 'master',
            excludeBranchesSpec: '',
            secretToken: gitlabWebhookToken
        )
    }

    parameters {
        booleanParam(
            name: 'FORCE_BACKEND_BUILD',
            defaultValue: false,
            description: '백엔드 변경이 없어도 운영 이미지를 빌드하고 배포한다.'
        )
    }

    environment {
        TARGET_BRANCH = 'master'
        KUBECTL_VERSION = 'v1.36.2'
        K8S_NAMESPACE = 's15a203-prod'
        MANIFEST_DIR = '06_Infra/prod'
    }

    stages {
        stage('Validate Branch') {
            steps {
                script {
                    def branch = env.gitlabBranch ?:
                            env.GIT_BRANCH?.replaceFirst(/^origin\//, '')
                    if (branch && branch != env.TARGET_BRANCH) {
                        error(
                                "운영 파이프라인은 ${env.TARGET_BRANCH} " +
                                "브랜치만 배포할 수 있습니다. 현재 브랜치: ${branch}"
                        )
                    }
                }
            }
        }

        stage('Detect Backend Changes') {
            steps {
                script {
                    env.GIT_COMMIT = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def beforeCommit =
                            env.gitlabBefore ?: env.GIT_PREVIOUS_COMMIT
                    def validBeforeCommit =
                            beforeCommit ==~ /[0-9a-fA-F]{40}/
                    def changedFiles

                    if (validBeforeCommit &&
                        beforeCommit !=
                                '0000000000000000000000000000000000000000' &&
                        beforeCommit != env.GIT_COMMIT &&
                        sh(
                            script: "git cat-file -e " +
                                    "${beforeCommit}^{commit}",
                            returnStatus: true
                        ) == 0) {
                        changedFiles = sh(
                            script: "git diff --name-only " +
                                    "${beforeCommit} ${env.GIT_COMMIT}",
                            returnStdout: true
                        ).trim()
                    } else {
                        changedFiles = sh(
                            script: 'git show --pretty= --name-only HEAD',
                            returnStdout: true
                        ).trim()
                    }

                    def deploymentChanged = changedFiles
                            .readLines()
                            .any {
                                it.startsWith('02_Backend/') ||
                                it.startsWith("${env.MANIFEST_DIR}/") ||
                                it == '06_Infra/Jenkinsfile.prod'
                            }

                    env.BACKEND_CHANGED = (
                            params.FORCE_BACKEND_BUILD || deploymentChanged
                    ).toString()

                    echo "Changed files:\n${changedFiles ?: '(none)'}"
                    echo "Force backend build: ${params.FORCE_BACKEND_BUILD}"
                    echo "Backend changed: ${env.BACKEND_CHANGED}"
                }
            }
        }

        stage('Prepare') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    script {
                        env.BACKEND_IMAGE =
                                "${env.DOCKERHUB_USERNAME}/" +
                                "s15a203-backend:${env.GIT_COMMIT}"
                    }
                }

                sh '''
                    mkdir -p .tools
                    curl -fsSLo .tools/kubectl \
                      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"
                    chmod +x .tools/kubectl
                '''
            }
        }

        stage('Backend Test') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                dir('02_Backend') {
                    sh 'chmod +x gradlew'
                    sh './gradlew test'
                }
            }
        }

        stage('Build and Push Image') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    dir('02_Backend') {
                        sh '''
                            set +x
                            ./gradlew jib \
                              --image="$BACKEND_IMAGE" \
                              -Djib.to.auth.username="$DOCKERHUB_USERNAME" \
                              -Djib.to.auth.password="$DOCKERHUB_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Approve Production') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                input(
                        message: '운영 환경에 새 백엔드 이미지를 배포할까요?',
                        ok: '운영 배포'
                )
                echo "운영 배포 승인 완료: ${env.BACKEND_IMAGE}"
            }
        }

        stage('Deploy Prod') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                sh '''
                    .tools/kubectl -n "$K8S_NAMESPACE" get \
                      deployment backend > /dev/null

                    .tools/kubectl -n "$K8S_NAMESPACE" set image \
                      deployment/backend backend="$BACKEND_IMAGE"

                    .tools/kubectl -n "$K8S_NAMESPACE" apply \
                      -f "$MANIFEST_DIR/service.yaml" \
                      -f "$MANIFEST_DIR/ingress.yaml"

                    .tools/kubectl -n "$K8S_NAMESPACE" rollout status \
                      deployment/backend --timeout=180s
                '''
            }
        }

        stage('Verify Prod') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                sh '''
                    .tools/kubectl -n "$K8S_NAMESPACE" get deployment backend
                    .tools/kubectl -n "$K8S_NAMESPACE" get \
                      pods -l app=backend -o wide
                    .tools/kubectl -n "$K8S_NAMESPACE" get service backend
                    .tools/kubectl -n "$K8S_NAMESPACE" get ingress backend
                    curl -fsS \
                      "https://i15a203.p.ssafy.io/api/v3/api-docs" \
                      > /dev/null
                '''
            }
        }
    }

    post {
        success {
            script {
                if (env.BACKEND_CHANGED == 'true') {
                    echo "운영 환경 배포 성공: ${env.BACKEND_IMAGE}"
                } else {
                    echo '02_Backend 변경이 없어 운영 배포를 건너뜁니다.'
                }
            }
        }
        failure {
            echo '운영 백엔드 빌드 또는 배포에 실패했습니다.'
        }
        aborted {
            echo '운영 배포가 승인되지 않았거나 취소되었습니다.'
        }
    }
}
