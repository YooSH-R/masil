pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        gitlab(
            triggerOnPush: true,
            triggerOnMergeRequest: false,
            branchFilterType: 'NameBasedFilter',
            includeBranchesSpec: 'dev',
            excludeBranchesSpec: ''
        )
    }

    parameters {
        booleanParam(
            name: 'FORCE_BACKEND_BUILD',
            defaultValue: false,
            description: '백엔드 변경이 없어도 이미지 빌드와 배포를 실행한다.'
        )
    }

    environment {
        KUBECTL_VERSION = 'v1.36.2'
        K8S_NAMESPACE = 's15a203-dev'
    }

    stages {
        stage('Detect Backend Changes') {
            steps {
                script {
                    env.GIT_COMMIT = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def beforeCommit = env.gitlabBefore ?: env.GIT_PREVIOUS_COMMIT
                    def validBeforeCommit = beforeCommit ==~ /[0-9a-fA-F]{40}/
                    def changedFiles

                    if (validBeforeCommit &&
                        beforeCommit != '0000000000000000000000000000000000000000' &&
                        beforeCommit != env.GIT_COMMIT &&
                        sh(script: "git cat-file -e ${beforeCommit}^{commit}", returnStatus: true) == 0) {
                        changedFiles = sh(
                            script: "git diff --name-only ${beforeCommit} ${env.GIT_COMMIT}",
                            returnStdout: true
                        ).trim()
                    } else {
                        changedFiles = sh(
                            script: 'git show --pretty= --name-only HEAD',
                            returnStdout: true
                        ).trim()
                    }

                    def backendChanged = changedFiles
                        .readLines()
                        .any { it.startsWith('02_Backend/') }

                    env.BACKEND_CHANGED = (params.FORCE_BACKEND_BUILD || backendChanged).toString()

                    echo "Changed files:\n${changedFiles ?: '(none)'}"
                    echo "Force backend build: ${params.FORCE_BACKEND_BUILD}"
                    echo "Backend changed: ${env.BACKEND_CHANGED}"
                }
            }
        }

        stage('Prepare') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    script {
                        env.BACKEND_IMAGE = "${env.DOCKERHUB_USERNAME}/s15a203-backend:${env.GIT_COMMIT.take(8)}"
                    }
                }

                sh '''
                    mkdir -p .tools
                    curl -fsSLo .tools/kubectl \
                      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"
                    chmod +x .tools/kubectl
                '''
            }
        }

        stage('Backend Test') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                dir('02_Backend') {
                    sh 'chmod +x gradlew'
                    sh './gradlew test'
                }
            }
        }

        stage('Build and Push Image') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    dir('02_Backend') {
                        sh '''
                            set +x
                            ./gradlew jib \
                              --image="$BACKEND_IMAGE" \
                              -Djib.to.auth.username="$DOCKERHUB_USERNAME" \
                              -Djib.to.auth.password="$DOCKERHUB_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Deploy to AWS k3s') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        .tools/kubectl -n "$K8S_NAMESPACE" create secret docker-registry dockerhub-registry \
                          --docker-server="https://index.docker.io/v1/" \
                          --docker-username="$DOCKERHUB_USERNAME" \
                          --docker-password="$DOCKERHUB_TOKEN" \
                          --dry-run=client -o yaml \
                          | .tools/kubectl apply -f -

                        sed "s|__BACKEND_IMAGE__|$BACKEND_IMAGE|g" 06_Infra/dev/deployment.yaml \
                          | .tools/kubectl -n "$K8S_NAMESPACE" apply -f -

                        .tools/kubectl -n "$K8S_NAMESPACE" apply \
                          -f 06_Infra/dev/service.yaml \
                          -f 06_Infra/dev/ingress.yaml

                        .tools/kubectl -n "$K8S_NAMESPACE" rollout status \
                          deployment/backend --timeout=180s
                    '''
                }
            }
        }

        stage('Verify') {
            when {
                expression { env.BACKEND_CHANGED == 'true' }
            }
            steps {
                sh '''
                    .tools/kubectl -n "$K8S_NAMESPACE" get deployment backend
                    .tools/kubectl -n "$K8S_NAMESPACE" get pods -l app=backend -o wide
                    .tools/kubectl -n "$K8S_NAMESPACE" get service backend
                    .tools/kubectl -n "$K8S_NAMESPACE" get ingress backend
                '''
            }
        }
    }

    post {
        success {
            script {
                if (env.BACKEND_CHANGED == 'true') {
                    echo "AWS k3s development deployment succeeded: ${env.BACKEND_IMAGE}"
                } else {
                    echo 'No 02_Backend changes. Backend pipeline skipped.'
                }
            }
        }
        failure {
            echo 'Backend build or AWS k3s deployment failed.'
        }
    }
}
