<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- API 호출과 카카오맵 타일 로딩에 필요하다.
         debug/profile 매니페스트에만 있어서 릴리즈 빌드에서는 네트워크가
         동작하지 않았다. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 마실이 기기 밑면의 QR 코드를 스캔한다(기기 등록). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- 카메라가 없는 기기에도 설치될 수 있게 required=false 로 둔다.
         (QR 등록만 못 하고 나머지 기능은 동작한다) -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- 감성 사진을 기기 갤러리에 저장한다(gal 패키지).
         안드로이드 10(API 29)부터는 MediaStore 로 저장해 권한이 필요 없으므로
         maxSdkVersion 으로 구형 기기에만 요청한다. 이걸 빼면 API 28 이하에서
         저장이 ACCESS_DENIED 로 실패한다. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <!-- 산책 경로를 휴대폰 GPS 로 기록한다(geolocator).
         FINE 은 경로를 그릴 정확도(수 m)를 위해, COARSE 는 사용자가 "대략적인
         위치"만 허용한 경우를 위해 둘 다 선언한다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- 산책 중에는 화면이 꺼지거나 앱이 뒤로 가도 좌표가 계속 찍혀야 한다.
         안드로이드는 그러려면 Foreground Service 가 필요하고, API 34+ 는
         용도별 권한(...SERVICE_LOCATION)까지 요구한다. 이게 없으면 화면을
         내리는 순간 경로가 끊긴다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- Foreground Service 는 알림을 반드시 띄워야 한다. 안드로이드 13(API 33)
         부터는 알림에도 권한이 필요해서, 이게 없으면 서비스 시작이 실패하고
         **위치 스트림이 아예 시작되지 않는다.**
         (그래서 첫 좌표만 찍히고 이후 갱신이 없는 증상이 난다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="mysil_project_new"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 카카오 로그인: 카카오톡/카카오계정 로그인 후 앱으로 돌아오는 리다이렉트 수신.
             스킴의 앱 키는 android/app/build.gradle.kts 의 manifestPlaceholders
             (local.properties 의 kakao.nativeAppKey)에서 채워진다.
             kakao_flutter_sdk_auth 가 선언한 액티비티에 intent-filter만 얹는다. -->
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakao${kakaoNativeAppKey}" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
